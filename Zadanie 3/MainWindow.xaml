<Window x:Class="Zadanie_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadanie_3"
        mc:Ignorable="d"
        Title="Учет торговых сетей" Height="570.5" Width="1110">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>


        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Выручка магазинов" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>


        <ListBox x:Name="ComputersListBox" Grid.Row="1" Grid.Column="0" 
                 Margin="0,0,10,10" FontFamily="Consolas" FontSize="12"/>


        <StackPanel Grid.Row="1" Grid.Column="1" Width="280" Margin="0,0,0,10">
            <GroupBox Header="Добавить продажи" Margin="0,0,0,10">
                <StackPanel Margin="5">

                    <ComboBox x:Name="TypeComboBox" Margin="0,0,0,8" SelectedIndex="0">
                        <ComboBoxItem Content="Нет скидок"/>
                        <ComboBoxItem Content="Есть скидки"/>
                    </ComboBox>

                    <TextBlock Text="Название магазина:" Margin="0,3,0,2"/>
                    <TextBox x:Name="ShopName" Margin="0,0,0,5" Padding="3"/>

                    <TextBlock Text="Количество продаж:" Margin="0,3,0,2"/>
                    <TextBox x:Name="SalesBox" Margin="0,0,0,5" Padding="3"/>

                    <TextBlock Text="Выручка за месяц:" Margin="0,3,0,2"/>
                    <TextBox x:Name="MoneyBox" Margin="0,0,0,5" Padding="3"/>

                    <TextBlock Text="Количество Покупателей:" Margin="0,3,0,2"/>
                    <TextBox x:Name="CustomersBox" Margin="0,0,0,5" Padding="3"/>

                    <StackPanel x:Name="discountPanel" Visibility="Collapsed">
                        <TextBlock Text="Скидка:" Margin="0,3,0,2"/>
                        <TextBox x:Name="DiscBox" Margin="0,0,0,5" Padding="3"/>
                    </StackPanel>

                    <Button x:Name="AddButton" Content="Добавить" Click="AddButton_Click" 
                            Margin="0,10,0,0" Padding="10,5" Background="LightGreen"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Удалить продажи">
                <StackPanel Margin="5">
                    <Button x:Name="DeleteSelectedButton" Content="Удалить выбранный" 
                            Click="DeleteSelectedButton_Click" Margin="0,5" Padding="10,5" Background="LightYellow"/>
                    <Button x:Name="DeleteLastButton" Content="Удалить последний" 
                            Click="DeleteLastButton_Click" Margin="0,5" Padding="10,5" Background="LightCoral"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>